# ============================================================
# Gold System — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --------------------------
# Application
# --------------------------
NODE_ENV=development
APP_PORT=4001
APP_PREFIX=api/v1
APP_NAME="Gold System API"

# --------------------------
# Database (PostgreSQL)
# --------------------------
DATABASE_URL="postgresql://gold_user:gold_pass@localhost:5432/gold_db?schema=public"

# --------------------------
# JWT
# --------------------------
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------
# OTP (SMS-based MFA)
# --------------------------
OTP_EXPIRES_IN_SECONDS=120
OTP_LENGTH=6

# --------------------------
# SMS Provider (SMS.ir or Melipayamak)
# docs/21-business-decisions.md §10.1
# The provider and the credentials can be changed at runtime from
# Dashboard → Settings → SMS. Values saved there win over the ones below.
# These entries are the fallback used before anything is saved in the panel
# (and after "reset to .env").
# SMS_PROVIDER=smsir | melipayamak | mock
# Never commit real credentials.
# --------------------------
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_SENDER_LINE=your_sender_line

# Secret used to encrypt the SMS credentials stored in the database.
# Falls back to JWT_ACCESS_SECRET when empty. Rotating it invalidates
# previously saved credentials (they must be re-entered in the panel).
SETTINGS_ENCRYPTION_KEY=change_me_settings_secret_min_32_chars

# SMS.ir (when SMS_PROVIDER=smsir)
SMSIR_BASE_URL=https://api.sms.ir/v1

# Melipayamak (when SMS_PROVIDER=melipayamak)
MELIPAYAMAK_BASE_URL=https://rest.payamak-panel.com/api/SendSMS
MELIPAYAMAK_PASSWORD=your_melipayamak_password

# --------------------------
# Local filesystem storage (replaces S3/MinIO)
# Root directory for uploaded files. Bucket names below become subdirectories
# and are immutable (they are embedded in existing database keys).
# --------------------------
STORAGE_LOCAL_ROOT=.data/uploads
STORAGE_BUCKET=gold-kyc
STORAGE_BUCKET_KYC=gold-kyc-documents
STORAGE_BUCKET_QUOTATIONS=gold-quotations

# --------------------------
# Price Feed
# --------------------------
PRICE_FEED_POLL_INTERVAL_MS=90000
PRICE_FEED_TTL_MS=180000
# Temporary fixed gold price (IRR per gram) until a live price API is connected.
MOCK_PRICE_IRR_PER_GRAM=265290000

# --------------------------
# Frontend (Next.js)
# --------------------------
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_APP_NAME="Gold System"
# Comma-separated. Include the LAN origin when other devices open the UI.
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000
