  recordedBy        User?               @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])
  trade             Trade               @relation(fields: [tradeId], references: [id])
  validatedBy       User?               @relation("PaymentValidatedBy", fields: [validatedByUserId], references: [id])

  @@index([tradeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

