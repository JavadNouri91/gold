/// One market calendar. Caps for a session live on TradingSession and can be
/// narrowed later by TradingLimit (role, user, customer, or transaction type).
model TradingSchedule {
  id        String           @id
  timezone  String           @default("Asia/Tehran")
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  sessions  TradingSession[]

  @@map("trading_schedules")
}

/// A calendar date that replaces the weekly template.
/// FULL_CLOSURE blocks the whole day. SPECIAL_SCHEDULE uses its own sessions.
model TradingDayOverride {
  id        String              @id @default(cuid())
  date      DateTime            @unique @db.Date
  kind      TradingOverrideKind
  title     String
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  sessions  TradingSession[]

  @@index([date])
  @@map("trading_day_overrides")
}

/// A weekly template session (weekday set) or a special-day session (dayOverrideId set).
/// Times are minutes from midnight in the schedule timezone. The interval is [start, end).
model TradingSession {
  id                   String              @id @default(cuid())
  scheduleId           String              @default("global") @map("schedule_id")
  weekday              TradingWeekday?
  dayOverrideId        String?             @map("day_override_id")
  title                String
  startMinute          Int                 @map("start_minute")
  endMinute            Int                 @map("end_minute")
  enabled              Boolean             @default(true)
  sortOrder            Int                 @default(0) @map("sort_order")
  maxAmountRial        Decimal?            @map("max_amount_rial") @db.Decimal(20, 2)
  minAmountRial        Decimal?            @map("min_amount_rial") @db.Decimal(20, 2)
  maxWeightGrams       Decimal?            @map("max_weight_grams") @db.Decimal(12, 6)
  minWeightGrams       Decimal?            @map("min_weight_grams") @db.Decimal(12, 6)
  maxCount             Int?                @map("max_count")
  maxSingleAmountRial  Decimal?            @map("max_single_amount_rial") @db.Decimal(20, 2)
  maxSingleWeightGrams Decimal?            @map("max_single_weight_grams") @db.Decimal(12, 6)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  schedule             TradingSchedule     @relation(fields: [scheduleId], references: [id])
  dayOverride          TradingDayOverride? @relation(fields: [dayOverrideId], references: [id], onDelete: Cascade)
  limits               TradingLimit[]

  @@index([weekday])
  @@index([dayOverrideId])
  @@index([startMinute, endMinute])
  @@map("trading_sessions")
}

model TradingLimit {
  id                   String            @id @default(cuid())
  scope                TradingLimitScope
  scopeKey             String?           @map("scope_key")
  sessionId            String?           @map("session_id")
  enabled              Boolean           @default(true)
  maxAmountRial        Decimal?          @map("max_amount_rial") @db.Decimal(20, 2)
  minAmountRial        Decimal?          @map("min_amount_rial") @db.Decimal(20, 2)
  maxWeightGrams       Decimal?          @map("max_weight_grams") @db.Decimal(12, 6)
  minWeightGrams       Decimal?          @map("min_weight_grams") @db.Decimal(12, 6)
  maxCount             Int?              @map("max_count")
  maxSingleAmountRial  Decimal?          @map("max_single_amount_rial") @db.Decimal(20, 2)
  maxSingleWeightGrams Decimal?          @map("max_single_weight_grams") @db.Decimal(12, 6)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  session              TradingSession?   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([scope, scopeKey])
  @@index([sessionId])
  @@map("trading_limits")
}
