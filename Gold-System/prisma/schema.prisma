model Notification {
  id                String              @id @default(cuid()) @db.VarChar(30)
  recipientId       String?             @map("recipient_id") @db.VarChar(30)
  recipientMobile   String?             @map("recipient_mobile") @db.VarChar(20)
  channel           NotificationChannel
  type              NotificationType
  subject           String?
  body              String
  status            NotificationStatus  @default(PENDING)
  relatedEntityType String?             @map("related_entity_type") @db.VarChar(100)
  relatedEntityId   String?             @map("related_entity_id") @db.VarChar(30)
  providerReference String?             @map("provider_reference") @db.VarChar(255)
  retry_count       Int                 @default(0)
  max_retries       Int                 @default(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)
  failedAt          DateTime?           @map("failed_at") @db.Timestamptz(6)
  errorMessage      String?             @map("error_message")
  readAt            DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipient         User?               @relation("UserNotifications", fields: [recipientId], references: [id], onUpdate: NoAction, map: "notifications_recipient_fk")

  @@index([recipientId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([recipientId, channel, createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}

