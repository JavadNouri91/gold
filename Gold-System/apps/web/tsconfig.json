{
  "extends": "@gold/tsconfig/nextjs.json",
  "compilerOptions": {
    "target": "ES2022",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@gold/shared-types": [
        "../../packages/shared-types/src/index.ts"
      ]
    },
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
